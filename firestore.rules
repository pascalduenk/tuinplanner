rules_version = '2';

// Beveiligingsregels voor de Tuinplanner.
// Alleen de e-mailadressen in de lijst hieronder mogen lezen en schrijven.
// Plak deze regels in de Firebase-console: Firestore Database → Regels → Publiceren.

service cloud.firestore {
  match /databases/{database}/documents {

    function isLid() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in [
          'pascalduenk@gmail.com',
          'annestolte@gmail.com'
        ];
    }

    match /{collectie}/{document} {
      allow read, write: if isLid()
        && collectie in ['gedaan', 'notities', 'planten', 'fotos', 'instellingen'];
    }
  }
}
